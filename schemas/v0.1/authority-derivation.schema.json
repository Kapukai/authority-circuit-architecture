{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kapukai.org/aca/v0.1/authority-derivation.schema.json",
  "title": "ACA Authority Derivation Graph",
  "type": "object",
  "required": [
    "derivation_id",
    "root_authority_id",
    "nodes",
    "edges",
    "verification_status"
  ],
  "properties": {
    "derivation_id": {
      "type": "string",
      "minLength": 1
    },
    "root_authority_id": {
      "type": "string",
      "minLength": 1
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "https://schemas.kapukai.org/aca/v0.1/authority.schema.json"
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "parent_authority_id",
          "child_authority_id",
          "delegation_basis",
          "constraints_preserved"
        ],
        "properties": {
          "parent_authority_id": {
            "type": "string"
          },
          "child_authority_id": {
            "type": "string"
          },
          "delegation_basis": {
            "type": "string"
          },
          "constraints_preserved": {
            "type": "boolean"
          },
          "unresolved_constraints": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "verification_status": {
      "enum": [
        "VERIFIED",
        "AUTHORITY_UNRESOLVED",
        "BROKEN_CHAIN",
        "CONFLICT"
      ]
    },
    "verified_at": {
      "$ref": "https://schemas.kapukai.org/aca/v0.1/common-defs.schema.json#/$defs/timestamp"
    },
    "verifier": {
      "$ref": "https://schemas.kapukai.org/aca/v0.1/common-defs.schema.json#/$defs/actor"
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}

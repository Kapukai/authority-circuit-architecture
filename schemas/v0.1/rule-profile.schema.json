{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kapukai.org/aca/v0.1/rule-profile.schema.json",
  "title": "ACA Rule Profile",
  "type": "object",
  "required": [
    "profile_id",
    "version",
    "supported_actions",
    "authority_requirements",
    "predicates",
    "precedence",
    "state_rules",
    "remedy_mappings"
  ],
  "properties": {
    "profile_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "WORKING_DRAFT",
        "PUBLIC_REVIEW",
        "CANDIDATE",
        "STABLE",
        "DEPRECATED"
      ]
    },
    "supported_actions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "authority_requirements": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "predicates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "predicate_id",
          "required",
          "kind",
          "evaluation"
        ],
        "properties": {
          "predicate_id": {
            "type": "string",
            "minLength": 1
          },
          "required": {
            "type": "boolean"
          },
          "kind": {
            "enum": [
              "OBJECTIVE",
              "EVIDENTIARY",
              "DISCRETIONARY",
              "NON_COMPUTABLE"
            ]
          },
          "evaluation": {
            "type": "string",
            "minLength": 1
          },
          "evidence_types": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "correctable": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "precedence": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.kapukai.org/aca/v0.1/common-defs.schema.json#/$defs/decisionState"
      },
      "minItems": 6,
      "uniqueItems": true
    },
    "state_rules": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "remedy_mappings": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "authority_source_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "change_point_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "integrity": {
      "$ref": "https://schemas.kapukai.org/aca/v0.1/common-defs.schema.json#/$defs/digest"
    }
  },
  "additionalProperties": false
}

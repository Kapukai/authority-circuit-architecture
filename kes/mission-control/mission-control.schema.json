{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kapukai.org/schemas/kes/mission-control/0.1",
  "title": "KES-0004 Mission Control Program State",
  "type": "object",
  "required": ["schema_version", "generated_at", "program", "items", "dependencies", "risks", "next_authorized_work"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "generated_at": {"type": "string", "format": "date-time"},
    "program": {
      "type": "object",
      "required": ["name", "status", "canonical_branch"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "status": {"$ref": "#/$defs/state"},
        "canonical_branch": {"type": "string", "minLength": 1},
        "statement": {"type": "string"}
      },
      "additionalProperties": false
    },
    "items": {
      "type": "array",
      "items": {"$ref": "#/$defs/item"}
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to", "kind"],
        "properties": {
          "from": {"type": "string"},
          "to": {"type": "string"},
          "kind": {"enum": ["REQUIRES", "INFORMS", "BLOCKS", "PROMOTES_TO", "VISUALIZES", "EVALUATES"]}
        },
        "additionalProperties": false
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "severity", "state", "owner", "containment"],
        "properties": {
          "id": {"type": "string"},
          "title": {"type": "string"},
          "severity": {"enum": ["LOW", "MODERATE", "HIGH", "CRITICAL"]},
          "state": {"enum": ["OPEN", "CONTAINED", "ACCEPTED", "CLOSED", "INDETERMINATE"]},
          "owner": {"type": "string"},
          "containment": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "critical_path": {
      "type": "array",
      "items": {"type": "string"}
    },
    "next_authorized_work": {
      "type": "object",
      "required": ["id", "authorized_by", "authorization_state"],
      "properties": {
        "id": {"type": "string"},
        "authorized_by": {"type": "string"},
        "authorization_state": {"enum": ["AUTHORIZED", "NOT_AUTHORIZED", "INDETERMINATE"]},
        "reason": {"type": "string"}
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "state": {
      "enum": ["PROPOSED", "AUTHORIZED", "IN_PROGRESS", "BLOCKED", "VERIFIED", "ACCEPTED", "RELEASED", "DEFERRED", "SUPERSEDED", "WITHDRAWN", "INDETERMINATE"]
    },
    "item": {
      "type": "object",
      "required": ["id", "name", "family", "state", "owner", "verification_state", "publication_state"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "family": {"enum": ["ACA", "AIM", "KAPU", "EDS", "KES", "RELEASE", "REPOSITORY", "PILOT"]},
        "state": {"$ref": "#/$defs/state"},
        "owner": {"type": "string", "minLength": 1},
        "branch": {"type": ["string", "null"]},
        "pull_request": {"type": ["integer", "null"], "minimum": 1},
        "verification_state": {"enum": ["NOT_RUN", "PASS", "FAIL", "INDETERMINATE"]},
        "publication_state": {"enum": ["NOT_PUBLISHED", "CANDIDATE", "AUTHORIZED", "PUBLISHED", "WITHDRAWN"]},
        "description": {"type": "string"},
        "blocking_reason": {"type": ["string", "null"]},
        "updated_at": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kapukai.org/kapu/v0.2/decision-proof-record.schema.json",
  "title": "KAPU Decision Proof Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "dpr_version",
    "record_id",
    "cell_id",
    "created_at",
    "profile_version",
    "rule_version",
    "state",
    "reason_code",
    "predicates",
    "authorization",
    "execution",
    "remedy",
    "input_sha256",
    "previous_record_sha256",
    "assurance",
    "record_sha256"
  ],
  "properties": {
    "dpr_version": {
      "const": "0.2.0"
    },
    "record_id": {
      "type": "string",
      "minLength": 1
    },
    "cell_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "profile_version": {
      "type": "string",
      "minLength": 1
    },
    "rule_version": {
      "type": "string",
      "minLength": 1
    },
    "state": {
      "enum": [
        "ALLOW",
        "DENY",
        "HOLD",
        "CONFLICT",
        "REVOKED",
        "ESCALATE"
      ]
    },
    "reason_code": {
      "type": "string",
      "minLength": 1
    },
    "predicates": {
      "type": "array",
      "minItems": 1
    },
    "authorization": {
      "type": [
        "object",
        "null"
      ]
    },
    "execution": {
      "type": [
        "object",
        "null"
      ]
    },
    "remedy": {
      "type": [
        "object",
        "null"
      ]
    },
    "input_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "previous_record_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "assurance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "integrity_is_not_truth",
        "human_approval_required",
        "ai_output_accepted_as_authority"
      ],
      "properties": {
        "integrity_is_not_truth": {
          "const": true
        },
        "human_approval_required": {
          "type": "boolean"
        },
        "ai_output_accepted_as_authority": {
          "const": false
        }
      }
    },
    "record_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}